{
  "name": "opencodeweb",
  // Bun 1.4.4 is the repo's pinned runtime, so it is already on PATH.
  "image": "oven/bun:1.4.4-debian",
  "remoteUser": "root",

  // Two cores keeps this inside the free 120 core-hours (60 hours) a month.
  "hostRequirements": { "cpus": 2 },

  "postCreateCommand": "bun install --frozen-lockfile",

  // The published CLI serves both the v2 API and the web UI on one origin.
  // Restarting the codespace re-runs this, so guard against a second copy.
  "postStartCommand": "bash -lc 'pgrep -f \"opencode serve\" >/dev/null || (nohup bunx @opencode/cli@2.4.1 serve --hostname 0.0.0.0 --port 4096 > /tmp/opencode.log 2>&1 &)'",

  "forwardPorts": [4096],
  "portsAttributes": {
    "4096": {
      "label": "OpenCode web",
      "onAutoForward": "openBrowser",
      "visibility": "public"
    }
  }
}
